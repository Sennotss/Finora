# PostgreSQL connection string (docker compose exposes the local DB on port 5433)
DATABASE_URL="postgresql://finora:finora@localhost:5433/finora?schema=public"
# Database used by integration tests (created automatically by docker/init-test-db.sql)
TEST_DATABASE_URL="postgresql://finora:finora@localhost:5433/finora_test?schema=public"
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Required when not running on Vercel
AUTH_TRUST_HOST=true
# Shared secret for the daily maintenance cron endpoint (Vercel sends it as a Bearer token)
CRON_SECRET=""
