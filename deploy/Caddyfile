# Caddy obtains and renews the HTTPS certificate for {$DOMAIN} automatically (Let's Encrypt).
# HTTPS is required for "Add to Home Screen" / app install on phones.
{$DOMAIN} {
	encode zstd gzip

	# Receipts are capped at 2 MB by the app; leave headroom for CSV/XLSX imports.
	request_body {
		max_size 10MB
	}

	reverse_proxy app:3000 {
		# Pass streamed (Suspense) responses through without buffering.
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
