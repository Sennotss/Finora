# Copy to .env.production on the server and fill in every value.
#   cp .env.production.example .env.production

# Your domain, without https:// (the public hostname configured on the Cloudflare Tunnel)
DOMAIN=

# Database password. Use letters and digits only (it goes into a connection URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Session signing key:  openssl rand -base64 32
AUTH_SECRET=

# Protects /api/cron/daily:  openssl rand -hex 32
CRON_SECRET=

# Cloudflare Tunnel token: Cloudflare dashboard -> Zero Trust -> Networks -> Tunnels ->
# Create a tunnel (Cloudflared) -> copy the token from the install command (the long "eyJ..." string)
TUNNEL_TOKEN=
