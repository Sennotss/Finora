# Copy to .env.production on the server and fill in every value.
#   cp .env.production.example .env.production

# Your domain, without https:// (its DNS A record must point to this server's IP)
DOMAIN=

# Database password. Use letters and digits only (it goes into a connection URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Session signing key:  openssl rand -base64 32
AUTH_SECRET=

# Protects /api/cron/daily:  openssl rand -hex 32
CRON_SECRET=
