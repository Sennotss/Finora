// Finora data model.
//
// Conventions
// - Every financial record carries `userId`; services always scope queries by it.
// - Money is stored as DECIMAL(19,4) and handled with decimal.js — never JS floats.
// - Calendar dates (transaction date, due dates, budget periods) are `@db.Date`
//   and are treated as UTC-midnight date-only values throughout the app.
// - Soft deletes use `deletedAt`; repositories exclude soft-deleted rows.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CASH
  BANK
  E_WALLET
  SAVINGS
  INVESTMENT
  CREDIT_CARD
  LOAN
  OTHER
}

enum AccountStatus {
  ACTIVE
  ARCHIVED
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  BANK_TRANSFER
  E_WALLET
  QRIS
  OTHER
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  ANNUAL
  CUSTOM
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
  CUSTOM
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
}

enum GoalCategory {
  EMERGENCY_FUND
  PURCHASE
  VACATION
  EDUCATION
  HOME
  GENERAL
}

enum ContributionType {
  CONTRIBUTION
  WITHDRAWAL
}

enum JournalType {
  DECISION
  REFLECTION
  UNEXPECTED_EXPENSE
  LESSON
  PRIORITY
  MONTHLY_REVIEW
}

enum NotificationType {
  BUDGET_ALERT
  BILL_DUE
  BILL_OVERDUE
  GOAL
  SYSTEM
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  /// Incremented on password change to invalidate existing sessions.
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  settings              UserSettings?
  accounts              Account[]
  categories            Category[]
  transactions          Transaction[]
  receipts              Receipt[]
  tags                  Tag[]
  budgets               Budget[]
  goals                 FinancialGoal[]
  goalContributions     GoalContribution[]
  recurringTransactions RecurringTransaction[]
  bills                 Bill[]
  billPayments          BillPayment[]
  snapshots             FinancialSnapshot[]
  exchangeRates         ExchangeRate[]
  notifications         Notification[]
  journalEntries        FinancialJournal[]
  importBatches         ImportBatch[]
}

model UserSettings {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  baseCurrency            String    @default("IDR") @db.VarChar(3)
  locale                  String    @default("id-ID")
  timezone                String    @default("Asia/Jakarta")
  /// 0 = Sunday, 1 = Monday
  weekStartsOn            Int       @default(1)
  budgetNormalThreshold   Int       @default(50)
  budgetModerateThreshold Int       @default(75)
  budgetWarningThreshold  Int       @default(90)
  emergencyFundMonths     Int       @default(6)
  billReminderDays        Int       @default(3)
  lastMaintenanceAt       DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id             String        @id @default(cuid())
  userId         String
  name           String
  type           AccountType
  currency       String        @db.VarChar(3)
  openingBalance Decimal       @default(0) @db.Decimal(19, 4)
  openingDate    DateTime      @db.Date
  institution    String?
  color          String        @default("#3b82f6")
  icon           String        @default("wallet")
  status         AccountStatus @default(ACTIVE)
  creditLimit    Decimal?      @db.Decimal(19, 4)
  notes          String?
  archivedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions           Transaction[]          @relation("SourceAccount")
  incomingTransfers      Transaction[]          @relation("DestinationAccount")
  goals                  FinancialGoal[]
  recurringTransactions  RecurringTransaction[] @relation("RecurringSource")
  recurringTransfersIn   RecurringTransaction[] @relation("RecurringDestination")
  bills                  Bill[]

  @@index([userId, status])
}

model Category {
  id        String       @id @default(cuid())
  userId    String
  name      String
  kind      CategoryKind
  parentId  String?
  color     String       @default("#64748b")
  icon      String       @default("tag")
  deletedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent                Category?              @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children              Category[]             @relation("CategoryTree")
  transactions          Transaction[]
  budgetCategories      BudgetCategory[]
  recurringTransactions RecurringTransaction[]
  bills                 Bill[]

  @@index([userId, kind])
  @@index([parentId])
}

model Transaction {
  id                     String          @id @default(cuid())
  userId                 String
  type                   TransactionType
  /// Always positive; `type` determines the direction.
  amount                 Decimal         @db.Decimal(19, 4)
  /// Currency of the source account at the time of recording.
  currency               String          @db.VarChar(3)
  /// For cross-currency transfers: the amount credited to the destination account.
  destinationAmount      Decimal?        @db.Decimal(19, 4)
  date                   DateTime        @db.Date
  description            String
  merchant               String?
  accountId              String
  destinationAccountId   String?
  categoryId             String?
  paymentMethod          PaymentMethod?
  notes                  String?
  /// Balance adjustments created by account reconciliation.
  isAdjustment           Boolean         @default(false)
  recurringTransactionId String?
  /// The scheduled occurrence date; unique per template so generation is idempotent.
  recurrenceDate         DateTime?       @db.Date
  importBatchId          String?
  deletedAt              DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account              Account               @relation("SourceAccount", fields: [accountId], references: [id], onDelete: NoAction)
  destinationAccount   Account?              @relation("DestinationAccount", fields: [destinationAccountId], references: [id], onDelete: NoAction)
  category             Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurringTransaction RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)
  importBatch          ImportBatch?          @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  tags                 TransactionTag[]
  receipt              Receipt?
  billPayment          BillPayment?

  @@unique([recurringTransactionId, recurrenceDate])
  @@index([userId, deletedAt, date])
  @@index([userId, accountId, date])
  @@index([userId, destinationAccountId])
  @@index([userId, categoryId, date])
  @@index([userId, type, date])
}

model Receipt {
  id            String   @id @default(cuid())
  userId        String
  transactionId String   @unique
  fileName      String
  mimeType      String
  size          Int
  data          Bytes
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model Tag {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#64748b")
  createdAt DateTime @default(now())

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TransactionTag[]

  @@unique([userId, name])
}

model TransactionTag {
  transactionId String
  tagId         String

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@index([tagId])
}

model Budget {
  id            String       @id @default(cuid())
  userId        String
  name          String
  period        BudgetPeriod
  /// Overall spending limit for one period, in the user's base currency.
  amount        Decimal      @db.Decimal(19, 4)
  /// Anchor for recurring periods; first day for CUSTOM budgets.
  startDate     DateTime     @db.Date
  /// Last day (inclusive) for CUSTOM budgets.
  endDate       DateTime?    @db.Date
  alertsEnabled Boolean      @default(true)
  notes         String?
  deletedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories BudgetCategory[]

  @@index([userId, deletedAt])
}

/// When a budget has no BudgetCategory rows it tracks all expenses.
model BudgetCategory {
  id         String  @id @default(cuid())
  budgetId   String
  categoryId String
  amount     Decimal @db.Decimal(19, 4)

  budget   Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([budgetId, categoryId])
}

model FinancialGoal {
  id              String       @id @default(cuid())
  userId          String
  name            String
  category        GoalCategory @default(GENERAL)
  targetAmount    Decimal      @db.Decimal(19, 4)
  targetDate      DateTime?    @db.Date
  priority        GoalPriority @default(MEDIUM)
  linkedAccountId String?
  description     String?
  notes           String?
  color           String       @default("#10b981")
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedAccount Account?           @relation(fields: [linkedAccountId], references: [id], onDelete: SetNull)
  contributions GoalContribution[]

  @@index([userId, deletedAt])
}

model GoalContribution {
  id        String           @id @default(cuid())
  goalId    String
  userId    String
  type      ContributionType
  amount    Decimal          @db.Decimal(19, 4)
  date      DateTime         @db.Date
  note      String?
  createdAt DateTime         @default(now())

  goal FinancialGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId, date])
  @@index([userId])
}

model RecurringTransaction {
  id                   String          @id @default(cuid())
  userId               String
  description          String
  type                 TransactionType
  amount               Decimal         @db.Decimal(19, 4)
  accountId            String
  destinationAccountId String?
  categoryId           String?
  paymentMethod        PaymentMethod?
  frequency            Frequency
  /// Repeat every N units (days for DAILY/CUSTOM, weeks, months, quarters, years).
  interval             Int             @default(1)
  startDate            DateTime        @db.Date
  endDate              DateTime?       @db.Date
  nextRunDate          DateTime        @db.Date
  isActive             Boolean         @default(true)
  notes                String?
  deletedAt            DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account            Account       @relation("RecurringSource", fields: [accountId], references: [id], onDelete: Cascade)
  destinationAccount Account?      @relation("RecurringDestination", fields: [destinationAccountId], references: [id], onDelete: Cascade)
  category           Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions       Transaction[]

  @@index([userId, isActive, nextRunDate])
}

model Bill {
  id             String    @id @default(cuid())
  userId         String
  name           String
  amount         Decimal   @db.Decimal(19, 4)
  currency       String    @db.VarChar(3)
  accountId      String?
  categoryId     String?
  frequency      Frequency
  interval       Int       @default(1)
  nextDueDate    DateTime  @db.Date
  endDate        DateTime? @db.Date
  isSubscription Boolean   @default(false)
  reminderDays   Int       @default(3)
  isActive       Boolean   @default(true)
  url            String?
  notes          String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  payments BillPayment[]

  @@index([userId, isActive, nextDueDate])
}

model BillPayment {
  id            String   @id @default(cuid())
  billId        String
  userId        String
  /// The due date this payment settles; unique per bill so paying is idempotent.
  dueDate       DateTime @db.Date
  paidDate      DateTime @db.Date
  amount        Decimal  @db.Decimal(19, 4)
  transactionId String?  @unique
  createdAt     DateTime @default(now())

  bill        Bill         @relation(fields: [billId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([billId, dueDate])
  @@index([userId])
}

/// Month-end snapshot of the user's position, in base currency.
model FinancialSnapshot {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @db.Date
  currency    String   @db.VarChar(3)
  assets      Decimal  @db.Decimal(19, 4)
  liabilities Decimal  @db.Decimal(19, 4)
  netWorth    Decimal  @db.Decimal(19, 4)
  income      Decimal  @db.Decimal(19, 4)
  expenses    Decimal  @db.Decimal(19, 4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

/// 1 unit of `fromCurrency` = `rate` units of `toCurrency`, effective from `date`.
model ExchangeRate {
  id           String   @id @default(cuid())
  userId       String
  fromCurrency String   @db.VarChar(3)
  toCurrency   String   @db.VarChar(3)
  rate         Decimal  @db.Decimal(24, 10)
  date         DateTime @db.Date
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fromCurrency, toCurrency, date])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  /// Stable key so generators can run repeatedly without duplicating notifications.
  dedupeKey String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

model FinancialJournal {
  id             String      @id @default(cuid())
  userId         String
  type           JournalType
  title          String
  content        String      @default("")
  entryDate      DateTime    @db.Date
  /// YYYY-MM, set only for MONTHLY_REVIEW entries (one per month).
  reviewMonth    String?
  wentWell       String?
  toImprove      String?
  nextPriorities String?
  /// 1 (bad) – 5 (great)
  mood           Int?
  amount         Decimal?    @db.Decimal(19, 4)
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewMonth])
  @@index([userId, deletedAt, entryDate])
}

model ImportBatch {
  id            String   @id @default(cuid())
  userId        String
  fileName      String
  totalRows     Int
  importedRows  Int
  skippedRows   Int
  createdAt     DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}
